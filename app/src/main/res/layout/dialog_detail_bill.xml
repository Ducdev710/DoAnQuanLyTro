<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/PADDING_SIZE_DEFAULT">

        <!-- Header section unchanged -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/PADDING_SIZE_SMALL"
            android:text="Chi tiết hóa đơn"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/TEXT_SIZE_LARGE"
            android:textColor="@color/white"
            android:background="@color/primary"/>

        <!-- ID and date section unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/PADDING_SIZE_SMALL">

            <TextView
                android:id="@+id/tv_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text=""/>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_craete_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="32/7/2023"/>
        </LinearLayout>

        <!-- Room and tenant info unchanged -->
        <TextView
            android:id="@+id/tv_name_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="A5"/>

        <TextView
            android:id="@+id/tv_tenant_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Nguyễn Văn A"/>

        <TextView
            android:id="@+id/tv_bill_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hóa đơn tháng: 7/2023"/>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="@color/black"
            android:layout_marginVertical="@dimen/PADDING_SIZE_SMALL"/>

        <!-- Bill info section unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/PADDING_SIZE_SMALL"
            android:background="@drawable/background_border_radius_2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/TEXT_SIZE_LARGE"
                android:text="Thông tin hóa đơn"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/grey"
                android:text="Thông tin về các sịch vụ phòng đã sử dụng trong tháng qua"/>
        </LinearLayout>

        <!-- Room price unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/PADDING_SIZE_SMALL">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiền phòng"/>

            <LinearLayout
                android:id="@+id/layout_price_room"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_price_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="6 222 222 VND"/>

                <EditText
                    android:id="@+id/edt_price_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Service fee unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Giá dịch vụ"/>

            <LinearLayout
                android:id="@+id/layout_price_service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_price_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="6 222 222 VND"/>

                <EditText
                    android:id="@+id/edt_price_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Additional Fee - NEW SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phụ phí"/>

            <LinearLayout
                android:id="@+id/layout_additional_fee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_additional_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="0 VND"/>

                <EditText
                    android:id="@+id/edt_additional_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Electricity info unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/PADDING_SIZE_SMALL"
            android:background="@drawable/background_border_radius_2"
            android:padding="@dimen/PADDING_SIZE_SMALL">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Chỉ số điện"/>

            <!-- Old electricity meter reading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chỉ số cũ"/>

                <TextView
                    android:id="@+id/tv_electricity_old"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:text="0"/>
            </LinearLayout>

            <!-- New electricity meter reading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chỉ số mới"/>

                <LinearLayout
                    android:id="@+id/layout_electricity_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tv_electricity_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="0"/>

                    <EditText
                        android:id="@+id/edt_electricity_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Electricity consumption -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiêu thụ"/>

                <LinearLayout
                    android:id="@+id/layout_electricity_index"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tv_electricity_index"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="23 số"/>

                    <EditText
                        android:id="@+id/edt_electricity_index"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Water info unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/PADDING_SIZE_SMALL"
            android:background="@drawable/background_border_radius_2"
            android:padding="@dimen/PADDING_SIZE_SMALL">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Chỉ số nước"/>

            <!-- Old water meter reading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chỉ số cũ"/>

                <TextView
                    android:id="@+id/tv_water_old"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:text="0"/>
            </LinearLayout>

            <!-- New water meter reading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chỉ số mới"/>

                <LinearLayout
                    android:id="@+id/layout_water_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tv_water_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="0"/>

                    <EditText
                        android:id="@+id/edt_water_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Water consumption -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiêu thụ"/>

                <LinearLayout
                    android:id="@+id/layout_water_index"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tv_water_index"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="32 Khối"/>

                    <EditText
                        android:id="@+id/edt_water_index"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Discount unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/PADDING_SIZE_SMALL">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiền miễn giảm"/>

            <LinearLayout
                android:id="@+id/layout_price_discount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_price_discount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="5 000 000 VND"/>

                <EditText
                    android:id="@+id/edt_price_discount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Note section unchanged -->
        <LinearLayout
            android:id="@+id/layout_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/PADDING_SIZE_SMALL">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ghi chú"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_border_radius_2"
                android:padding="@dimen/PADDING_SIZE_SMALL"
                android:layout_marginTop="4dp"
                android:minHeight="60dp"
                android:textColor="@color/grey"
                android:visibility="visible"
                tools:text="Ghi chú về hóa đơn"/>

            <EditText
                android:id="@+id/edt_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_border_radius_2"
                android:padding="@dimen/PADDING_SIZE_SMALL"
                android:layout_marginTop="4dp"
                android:minHeight="60dp"
                android:gravity="top"
                android:visibility="gone"
                android:hint="Nhập ghi chú"/>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="@color/black"
            android:layout_marginVertical="@dimen/PADDING_SIZE_SMALL"/>

        <!-- Total amount section unchanged -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/TEXT_SIZE_LARGE"
                android:textStyle="bold"
                android:text="Tổng tiền: "/>

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/TEXT_SIZE_LARGE"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:text="2 232 124 VND"/>

        </LinearLayout>

        <!-- Payment status unchanged -->
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cb_payed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:buttonTint="@color/check_box_color_selector"
            android:layout_marginTop="@dimen/PADDING_SIZE_DEFAULT"
            android:text="Đã thanh toán"/>

        <!-- Button container unchanged -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/PADDING_SIZE_DEFAULT">

            <!-- Edit button - only visible for admin when bill is unpaid -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Chỉnh sửa"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:elevation="0dp"
                android:layout_marginEnd="8dp"
                android:stateListAnimator="@null"
                android:backgroundTint="@color/primary"
                android:background="@drawable/background_button"
                android:visibility="gone"/>

            <!-- Save button - only visible in edit mode -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Lưu"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:elevation="0dp"
                android:layout_marginEnd="8dp"
                android:stateListAnimator="@null"
                android:backgroundTint="@color/green"
                android:background="@drawable/background_button"
                android:visibility="gone"/>

            <!-- Close/Cancel button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_end"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Đóng"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:backgroundTint="@color/primary"
                android:background="@drawable/background_button"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>